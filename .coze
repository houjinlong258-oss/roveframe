[project]
sub_id = "e679bddf"
name = "roveframe-ai-business-os"
requires = ["nodejs-24"]
project_type = "web"
version = "0.0.35"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/prepare.sh"]
run = ["bash", "scripts/dev.sh"]

[deploy]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/start.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]