# RoveFrame application
NEXT_PUBLIC_APP_URL=https://replace-me.example
COZE_PROJECT_ENV=replace-me

# RoveFrame Business Database (Supabase)
COZE_SUPABASE_URL=https://replace-me.supabase.co
COZE_SUPABASE_ANON_KEY=replace-me
COZE_SUPABASE_SERVICE_ROLE_KEY=replace-me
COZE_SUPABASE_JWT_SECRET=replace-me
SUPABASE_ACCESS_TOKEN=replace-me

# Credential encryption
ENCRYPTION_SECRET=replace-me-with-at-least-32-random-bytes

# RoveAgent Core service boundary
ROVEAGENT_API_URL=https://replace-me.internal
ROVEAGENT_API_KEY=replace-me-with-a-random-service-key
ROVEAGENT_APPROVAL_SECRET=replace-me-with-a-separate-random-signing-key
ROVEFRAME_INTERNAL_API_URL=https://replace-me.internal

# Web Push / Notifications
# 生成 keypair: node scripts/generate-vapid.mjs
WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
WEB_PUSH_VAPID_PRIVATE_KEY=replace-me
WEB_PUSH_VAPID_SUBJECT=mailto:replace-me@example.com
# 客户端订阅用的公钥（必须与 WEB_PUSH_VAPID_PUBLIC_KEY 一致，前缀 NEXT_PUBLIC 会进浏览器包）
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
# 通知投递（Email 主通道 + Web Push 增强）：默认开启；仅当显式设为 false 时关闭
ROVEFRAME_ENABLE_NOTIFICATION_DISPATCH=true

# Provider runtime controls (merchant credentials are encrypted in the database)
SQUARE_API_VERSION=2026-08-19
# Square OAuth (Connect with Square): App ID/Secret from the Square Developer
# Console; callback URL must be <NEXT_PUBLIC_APP_URL>/api/integrations/square/oauth/callback
SQUARE_APP_ID=replace-me
SQUARE_APP_SECRET=replace-me
# Keep unset in production. Set to 1 only for an explicitly approved test deployment.
STRIPE_ALLOW_TEST_MODE=replace-me
