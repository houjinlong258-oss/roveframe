# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# RoveFrame AI Business OS — RoveAgent Runtime (Python 3.13 / FastAPI)
#
# Phase 11 / Task 2. This is the container that makes the Python execution plane
# reachable for the first time. Before it, `.coze` declared only
# `requires = ["nodejs-24"]` and scripts/start.sh ran `node dist/server.js`
# alone — the deployed artefact contained no Python, no FastAPI and no way to
# start the runtime, so /api/agent/chat could only ever 502.
#
# Why an EDITABLE install (`pip install -e`):
#   roveagent/pyproject.toml declares `[tool.setuptools.packages.find]
#   where = [".."]`, i.e. the package root is the PARENT of roveagent/, so the
#   project must be installed from a directory that contains roveagent/. More
#   importantly its `[tool.setuptools.package-data]` only covers .md/.json/.yaml
#   under skills_library and plugins — the tree also ships .mjs/.js/.html/.sh
#   templates that no pattern matches. A non-editable `pip install .` would
#   silently build a wheel with those templates missing. Editable keeps the
#   source tree authoritative.
#
# Why python:3.13: pyproject requires >=3.11,<3.14. The two `sys_platform ==
# 'win32'`-marked dependencies (tzdata, concurrent-log-handler) self-exclude on
# Linux, and every Windows code path in the runtime is `sys.platform`-guarded.
#
# Why the repo's own launcher is the entrypoint: scripts/roveagent-service.sh
# already (a) fails fast when ROVEAGENT_API_KEY / ROVEAGENT_APPROVAL_SECRET are
# missing, (b) refuses to start when the approval secret equals the API key,
# (c) unifies ROVEAGENT_HOME with ROVEAGENT_ROOT so state does not split across
# two roots, and (d) can start the Mock LLM provider for contract testing.
# Re-implementing that in the Dockerfile would be a second, divergent copy.
# ---------------------------------------------------------------------------

FROM python:3.13-slim-bookworm

# No apt layer on purpose. The only system package that was ever wanted here is
# `curl`, purely to back the HEALTHCHECK — and `python:3.13-slim` ships a full
# CPython, so the probe can be a stdlib one-liner instead. Dropping it removes a
# build-time dependency on the Debian archive (which failed outright on the
# authoring network: `bookworm/main` was unreachable while `bookworm-security`
# and `bookworm-updates` resolved), keeps the image smaller, and leaves fewer
# moving parts to audit.
#
# No compiler is needed either: every pinned dependency resolves to a
# manylinux wheel (cryptography, Pillow, psutil, uvloop, httptools, watchfiles
# all ship one), so a wheel-only install succeeds on this base image.
#
# ca-certificates is already present in python:3.13-slim; the runtime's own CA
# validation (roveagent/core/ssl_guard.py) checks the certifi bundle that pip
# installs, not the system store.

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ROVEAGENT_HOST=0.0.0.0 \
    ROVEAGENT_PORT=8788 \
    ROVEAGENT_ROOT=/data \
    ROVEAGENT_HOME=/data

# pip is used here only to install the project itself; the project's own package
# manager rule (pnpm-only) governs JS dependencies, not Python ones.
COPY roveagent/ ./roveagent/
COPY scripts/roveagent-service.sh scripts/mock_llm_provider.py ./scripts/

# `where = [".."]` resolves to /app, which is where roveagent/ now lives.
RUN pip install --no-cache-dir -e "./roveagent[web]"

# Non-root runtime user, created BEFORE the writable directories so ownership
# can be assigned once, to the same UID, everywhere.
#
# Regression note (found by actually running the container, not by reading it):
# an earlier revision chowned /data to 1000 while creating this user as 10001.
# The container therefore started, served nothing, and failed its healthcheck
# with `PermissionError: [Errno 13] Permission denied: '/data/tenants'` —
# TenantManager creates <root>/tenants on first request. UID_RUNTIME is defined
# once here so the two numbers cannot drift apart again.
ARG UID_RUNTIME=10001
RUN useradd --uid ${UID_RUNTIME} --create-home --shell /bin/bash rove

# State root. Declared as a volume so chat sessions, tenant memory, audit
# records and installed skills survive a container replacement — the audit
# flagged "容器回收即丢" as a production blocker.
#
# The ownership set here is what a fresh named volume inherits when Docker
# initialises it from the image, so getting it right is what makes the mounted
# volume writable by the non-root user.
RUN mkdir -p /data \
 && chown -R ${UID_RUNTIME}:${UID_RUNTIME} /data \
 && chown -R ${UID_RUNTIME}:${UID_RUNTIME} /app

USER ${UID_RUNTIME}

EXPOSE 8788

# Unauthenticated by design (see Runtime_Deployment_Report.md finding R-06);
# the port is published only on the compose-internal network.
#
# Stdlib probe instead of curl: python:3.13-slim has no curl, and adding one
# would mean an apt layer. urllib is always present.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8788/api/health', timeout=4).status == 200 else 1)" || exit 1

WORKDIR /app
CMD ["bash", "scripts/roveagent-service.sh", "--host", "0.0.0.0", "--port", "8788"]
