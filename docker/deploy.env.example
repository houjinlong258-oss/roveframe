# ---------------------------------------------------------------------------
# RoveFrame AI Business OS — compose environment template
#
#   cp docker/deploy.env.example docker/deploy.env
#   <fill in every value marked REQUIRED>
#   docker compose --env-file docker/deploy.env up -d --build
#
# This file is a TEMPLATE. Never commit a filled-in copy.
# `docker/deploy.env` matches the `*.env` rule in .gitignore.
#
# Do NOT reuse the repository's scripts/deploy.env here. That file is the local
# development credential store; the image deliberately excludes it.
# ---------------------------------------------------------------------------

# === Runtime authentication =================================================
# Shared by BOTH services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
#
# REQUIRED. The two values MUST be different: the runtime answers 503 when they
# match, so that holding the caller key does not also confer approval-signing
# authority.
ROVEAGENT_API_KEY=
ROVEAGENT_APPROVAL_SECRET=

# === Database (external Supabase) ===========================================
# REQUIRED.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
# REQUIRED in production; the web service refuses to start without it.
COZE_SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: enables local JWT verification instead of a remote
# call per request.
COZE_SUPABASE_JWT_SECRET=

# === Credential encryption ==================================================
# REQUIRED in production — src/lib/crypto.ts throws when it is missing.
# MUST be a different value from COZE_SUPABASE_SERVICE_ROLE_KEY: reusing the
# database superuser credential as the encryption key means rotating that
# credential makes every stored secret permanently undecryptable.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=

# === LLM provider for the RoveAgent runtime =================================
# REQUIRED. Without it /api/agent/chat returns 503 by design — the runtime never
# fabricates an answer.
ROVEAGENT_LLM_API_KEY=
# Leave empty for the OpenAI default endpoint.
ROVEAGENT_LLM_BASE_URL=
ROVEAGENT_LLM_MODEL=gpt-4o-mini

# === Wiring (defaults are correct for this compose file) ====================
# ROVEFRAME_INTERNAL_API_URL=http://web:5000
# WEB_PORT=5000
# NPM_REGISTRY=https://registry.npmmirror.com

# === Test only ==============================================================
# Never enable in production.
# ROVEAGENT_TEST_MODE=false
