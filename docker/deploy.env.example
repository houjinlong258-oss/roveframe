# ---------------------------------------------------------------------------
# RoveFrame AI Business OS — compose environment template
#
# TWO WAYS TO DEPLOY. Pick one; do not mix them.
#
#   (A) Built-in database — recommended, nothing external to sign up for:
#         bash install.sh                     # generates docker/deploy.env for you
#       `install.sh` writes this file itself (mode 600) and starts
#       docker-compose.yml + docker-compose.selfhosted.yml together. You never
#       fill in anything below by hand, and you never type a database password.
#       See docs/current/SelfHosted_Deploy_And_Merchant_Site_Plan.md §2.
#
#   (B) External Supabase — what the rest of this template describes:
#         cp docker/deploy.env.example docker/deploy.env
#         <fill in every value marked REQUIRED>
#         docker compose --env-file docker/deploy.env up -d --build
#
# This file is a TEMPLATE. Never commit a filled-in copy.
# `docker/deploy.env` matches the `*.env` rule in .gitignore.
#
# Do NOT reuse the repository's scripts/deploy.env here. That file is the local
# development credential store; the image deliberately excludes it.
# ---------------------------------------------------------------------------

# === Built-in database (only for path A) ====================================
# install.sh generates all of these. Listed so the contract is visible.
# POSTGRES_PASSWORD=            # applied to the supabase roles on FIRST boot
# JWT_SECRET=                   # signs the anon/service_role keys and sessions
# COZE_SUPABASE_URL=http://gateway
# STORAGE_PUBLIC_BASE_URL=      # browser-facing base for uploaded media
# NEXT_PUBLIC_APP_URL=          # public origin; read at RUNTIME, not baked in
# SITE_DOMAIN=                  # empty = IP-only install
# ACME_EMAIL=                   # optional certificate expiry notices
# IMAGE_REGISTRY=               # e.g. docker.m.daocloud.io/ when Docker Hub is blocked

# === Runtime authentication =================================================

# Shared by BOTH services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
#
# REQUIRED. The two values MUST be different: the runtime answers 503 when they
# match, so that holding the caller key does not also confer approval-signing
# authority.
ROVEAGENT_API_KEY=
ROVEAGENT_APPROVAL_SECRET=

# === Database (external Supabase) ===========================================
# REQUIRED.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
# REQUIRED in production; the web service refuses to start without it.
COZE_SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: enables local JWT verification instead of a remote
# call per request.
COZE_SUPABASE_JWT_SECRET=

# === Credential encryption ==================================================
# REQUIRED in production — the app refuses to start without it (Phase 12 / R-03).
# MUST be a different value from COZE_SUPABASE_SERVICE_ROLE_KEY: reusing the
# database superuser credential as the encryption key means rotating that
# credential makes every stored secret permanently undecryptable.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=

# Optional, DECRYPTION ONLY. Set while rotating ENCRYPTION_SECRET so existing
# rows stay readable; it is never used to encrypt. Accepts a comma-separated
# list for multi-step rotations.
#
# Migrating from an older build? Those rows were encrypted with a key derived
# from the Supabase service key — put that service key value here, re-encrypt,
# then remove this line.
#
# NOTE (Phase 15): setting this variable here is NOT enough on its own. Compose
# passes an explicit whitelist, so a variable absent from docker-compose.yml is
# silently dropped and never reaches the container. It is now listed there.
# ENCRYPTION_SECRET_PREVIOUS=

# === Platform built-in model (self-hosted deployments) ======================
# Optional. Without these — and without a platform-injected COZE_API_TOKEN —
# a tenant that has no model provider configured (model_assign "auto") has NO
# working model: the built-in fallback carries no credential. A newly registered
# business lands in exactly that state, because signup creates tenant, business,
# auth user and public.users but no settings row.
#
# Set both to give the platform fallback a working OpenAI-compatible endpoint.
# The base URL passes the same SSRF validation as tenant-supplied URLs, so a
# private or link-local address is refused rather than silently allowed.
# ROVEFRAME_PLATFORM_LLM_API_KEY=
# ROVEFRAME_PLATFORM_LLM_BASE_URL=
# Optional: overrides the model AUTO_ROUTE picks for every capability.
# ROVEFRAME_PLATFORM_LLM_MODEL=

# === LLM provider for the RoveAgent runtime =================================
# REQUIRED. Without it /api/agent/chat returns 503 by design — the runtime never
# fabricates an answer.
ROVEAGENT_LLM_API_KEY=
# Leave empty for the OpenAI default endpoint.
ROVEAGENT_LLM_BASE_URL=
ROVEAGENT_LLM_MODEL=gpt-4o-mini

# === Wiring (defaults are correct for this compose file) ====================
# ROVEFRAME_INTERNAL_API_URL=http://web:5000
# WEB_PORT=5000
# NPM_REGISTRY=https://registry.npmmirror.com

# === Test only ==============================================================
# Never enable in production.
# ROVEAGENT_TEST_MODE=false
