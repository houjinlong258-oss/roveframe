{
  "name": "@roveframe/ai-business-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && tsup src/server.ts --format cjs --platform node --target node20 --outDir dist --no-splitting --no-minify",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "lint": "eslint src --cache --cache-location .cache/eslint",
    "lint:build": "eslint src --quiet --cache --cache-location .cache/eslint",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "bash ./scripts/start.sh",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "python -m unittest discover -s roveagent -t . -p *_test.py",
    "e2e:recovery": "tsx scripts/e2e-recovery-campaign.mts",
    "ts-check": "tsc -p tsconfig.json --noEmit",
    "scan:secrets": "node scripts/production-scan.mjs secrets",
    "scan:brand": "node scripts/production-scan.mjs brand",
    "scan:globals": "node scripts/production-scan.mjs globals",
    "scan:artifacts": "node scripts/production-scan.mjs artifacts",
    "scan:production": "node scripts/production-scan.mjs all",
    "package:source": "python scripts/package-source.py",
    "validate:migrations": "node scripts/verify-migrations.mjs",
    "validate": "pnpm validate:migrations && pnpm ts-check && pnpm lint:build && pnpm lint:style && pnpm test && pnpm scan:production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
